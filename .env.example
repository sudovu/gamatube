# GAMATUBE Environment Configuration Template
# Duplicate this file to .env and provide your values.
# NEVER commit your actual .env file or credentials to Git.

# Optional: Google OAuth 2.0 Web / Desktop Client ID for account sync
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Optional: Dedicated Google Cloud YouTube Data API v3 Key
# If omitted, GAMATUBE provides default permitted browsing experience with offline fallback
YOUTUBE_API_KEY=

# Optional: AI Service Provider (options: local, gemini, disabled)
AI_PROVIDER=local
GEMINI_API_KEY=
